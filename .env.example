# Live e2e is opt-in. Do not commit real values.
SIGNAL_TS_E2E=1
SIGNAL_TS_E2E_ACCOUNT_FILE=/secure/path/signal-ts-account.json

# Optional timeout override in milliseconds.
SIGNAL_TS_E2E_TIMEOUT_MS=120000

# Optional QR provisioning/linking flow. This is off by default because it
# waits for a phone to scan the printed sgnl://linkdevice URL.
SIGNAL_TS_E2E_LINK_DEVICE=0
SIGNAL_TS_E2E_LINK_OUTPUT_FILE=/secure/path/new-linked-device-state.json
SIGNAL_TS_E2E_LINK_DEVICE_NAME="OpenClaw signal-ts e2e"
SIGNAL_TS_E2E_LINK_TIMEOUT_MS=300000
SIGNAL_TS_E2E_LINK_ENVIRONMENT=production

# The account file must be JSON. Prefer stateFile entries that point at
# FileSignalRepository JSON state produced by linkSignalDevice. Relative paths
# are resolved from SIGNAL_TS_E2E_ACCOUNT_FILE. Inline repository snapshots are
# still accepted for isolated fixtures.
# {
#   "environment": "production",
#   "accounts": {
#     "sender": {
#       "stateFile": "/secure/path/sender-signal-ts-state.json",
#       "accessKeyBase64": null
#     },
#     "receiver": {
#       "stateFile": "/secure/path/receiver-signal-ts-state.json",
#       "accessKeyBase64": null
#     }
#   }
# }
#
# Inline snapshot form:
# {
#   "environment": "production",
#   "accounts": {
#     "sender": {
#       "auth": {
#         "username": "<Signal service username for sender linked device>",
#         "password": "<Signal service password for sender linked device>"
#       },
#       "device": {
#         "aci": "11111111-1111-4111-8111-111111111111",
#         "e164": "+15555550123",
#         "deviceId": 2,
#         "registrationId": 12345
#       },
#       "receiveStories": false,
#       "accessKeyBase64": null,
#       "repository": {
#         "identityKeyPrivate": "<base64 private identity key>",
#         "registrationId": 12345,
#         "identities": {},
#         "sessions": {},
#         "preKeys": {},
#         "signedPreKeys": {},
#         "kyberPreKeys": {},
#         "senderKeys": {}
#       }
#     },
#     "receiver": {
#       "auth": {
#         "username": "<Signal service username for receiver linked device>",
#         "password": "<Signal service password for receiver linked device>"
#       },
#       "device": {
#         "aci": "22222222-2222-4222-8222-222222222222",
#         "e164": "+15555550124",
#         "deviceId": 2,
#         "registrationId": 23456
#       },
#       "receiveStories": false,
#       "accessKeyBase64": null,
#       "repository": {
#         "identityKeyPrivate": "<base64 private identity key>",
#         "registrationId": 23456,
#         "identities": {},
#         "sessions": {},
#         "preKeys": {
#           "1": "<base64 serialized PreKeyRecord>"
#         },
#         "signedPreKeys": {
#           "1": "<base64 serialized SignedPreKeyRecord>"
#         },
#         "kyberPreKeys": {
#           "1": "<base64 serialized KyberPreKeyRecord>"
#         },
#         "senderKeys": {}
#       }
#     }
#   }
# }
